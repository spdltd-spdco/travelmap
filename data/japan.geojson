    {
      "type": "Feature",
      "properties": {
        "kind": "polygon",
        "name": "Kabukicho",
        "color": "#f2a103",
        "blurb": "Neon nightlife blocks packed with bars, karaoke, and clubs.",
        "notes": "Tokyo's biggest entertainment district — small clubs, karaoke boxes, and the Godzilla head looming over the Toho building. Golden Gai and Omoide Yokocho sit right at its edges. Isetan and Shinjuku Gyoen are an easy walk south. Traced by hand off Google Maps, not generated."
      },
