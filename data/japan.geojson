    {
      "type": "Feature",
      "properties": {
        "kind": "polygon",
        "name": "Golden Gai",
        "color": "#9d4edd",
        "blurb": "~200 tiny bars packed into six narrow alleys.",
        "notes": "Each bar seats maybe 5-10 people; many charge a small cover (¥500-1500) plus drinks. Some are locals-only, but a growing number post \"tourists welcome\" signs. Right at Kabukicho's edge — walkable in under 5 minutes from Golden Gai to Omoide Yokocho."
      },
